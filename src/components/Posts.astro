---
import { getCollection } from "astro:content";

interface Props {
    limit?: number;
    heading?: string;
}

const { limit, heading = "Thoughts" } = Astro.props;

const allPosts = (await getCollection("posts")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const posts = limit ? allPosts.slice(0, limit) : allPosts;
const hasMore = limit !== undefined && allPosts.length > limit;

const fmt = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
});
---

<section data-posts class="flex flex-col gap-8" aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="text-xl font-semibold text-mauve-800">{heading}</h2>
    <div class="relative flex flex-col gap-1 -mx-4" data-posts-list>
        <span
            aria-hidden="true"
            class="hover-lens pointer-events-none absolute left-0 top-0 rounded-2xl opacity-0 transition-[transform,width,height,opacity] duration-300 ease-out"
            data-hover-bg
        ></span>

        {posts.map((p) => (
            <a
                href={`/b/${p.id}`}
                data-post-link
                class="post-link relative flex flex-col gap-1 px-4 py-3 no-underline text-mauve-800 md:flex-row md:items-baseline md:gap-8"
            >
                <span class="text-sm w-28 shrink-0 tabular-nums whitespace-nowrap text-mauve-600">
                    <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                </span>
                <span class="flex min-w-0 flex-col gap-1">
                    <span
                        class="underline decoration-mauve-800/40 underline-offset-2 decoration-2 line-clamp-2"
                        transition:name={`post-title-${p.id}`}
                    >
                        {p.data.title}
                    </span>
                    <span class="text-sm text-mauve-600 line-clamp-2">
                        {p.data.description}
                    </span>
                </span>
            </a>
        ))}
    </div>
    {hasMore && (
        <a
            href="/b"
            class="self-start text-sm text-mauve-700 underline decoration-mauve-800/40 underline-offset-2 decoration-2 hover:decoration-mauve-800/80"
        >
            More&nbsp;→
        </a>
    )}
</section>

<style>
    .hover-lens {
        box-shadow:
            inset 0 1px 0 0 rgba(255, 255, 255, 0.55),
            inset 0 -1px 0 0 rgba(255, 255, 255, 0.18),
            0 0 0 1px rgba(255, 255, 255, 0.22),
            0 6px 18px -6px rgba(20, 16, 34, 0.18);
    }
    .post-link:focus-visible {
        outline: 2px solid var(--color-mauve-800);
        outline-offset: -2px;
        border-radius: 12px;
    }
    @media (prefers-reduced-motion: reduce) {
        [data-hover-bg] {
            transition: opacity 80ms linear !important;
        }
    }
</style>

<script>
    function initPosts(root: HTMLElement) {
        const list = root.querySelector<HTMLElement>("[data-posts-list]");
        const hoverBg = root.querySelector<HTMLElement>("[data-hover-bg]");
        const links = root.querySelectorAll<HTMLAnchorElement>("[data-post-link]");
        if (!list || !hoverBg || !links.length) return;

        const moveBgTo = (link: HTMLElement) => {
            const listRect = list.getBoundingClientRect();
            const r = link.getBoundingClientRect();
            hoverBg.style.transform = `translate(${r.left - listRect.left}px, ${r.top - listRect.top}px)`;
            hoverBg.style.width = `${r.width}px`;
            hoverBg.style.height = `${r.height}px`;
            hoverBg.style.opacity = "1";
        };

        const hide = () => {
            hoverBg.style.opacity = "0";
        };

        links.forEach((link) => {
            link.addEventListener("pointerenter", (e) => {
                if (e.pointerType === "touch") return;
                moveBgTo(link);
            });
            link.addEventListener("focus", () => {
                if (!link.matches(":focus-visible")) return;
                moveBgTo(link);
            });
        });

        list.addEventListener("pointerleave", (e) => {
            if (e.pointerType === "touch") return;
            hide();
        });
        list.addEventListener("focusout", (e) => {
            if (!list.contains(e.relatedTarget as Node)) hide();
        });
    }

    const run = () =>
        document.querySelectorAll<HTMLElement>("[data-posts]").forEach(initPosts);

    run();
    document.addEventListener("astro:page-load", run);
</script>
