---
interface Social {
    label: string;
    href: string;
}

const socials: Social[] = [
    {
        label: "twitter",
        href: "https://x.com/gregortokarev",
    },
    {
        label: "github",
        href: "https://github.com/gregor-tokarev",
    },
];
---

<nav aria-label="Social links">
    <div class="flex flex-row flex-wrap items-center gap-1 -mx-3 w-fit">
        {socials.map((s) => (
            <a
                href={s.href}
                target="_blank"
                rel="me noopener noreferrer"
                data-umami-event="social_click"
                data-umami-event-social={s.label}
                data-hover-target
                class="social-link relative flex items-center gap-1.5 px-3 py-1.5 no-underline text-mauve-800"
            >
                <span class="underline decoration-mauve-800/40 underline-offset-2 decoration-2">
                    {s.label}
                    <span class="sr-only"> (opens in a new tab)</span>
                </span>
            </a>
        ))}
    </div>
</nav>

<style>
    .social-link:focus-visible {
        outline: 2px solid var(--color-mauve-800);
        outline-offset: -2px;
        border-radius: 10px;
    }
</style>
