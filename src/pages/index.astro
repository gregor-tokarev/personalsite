---
import Base from "../layouts/Base.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Posts from "../components/Posts.astro";
import Socials from "../components/Socials.astro";
import HoverLens from "../components/HoverLens.astro";
import { Image } from "astro:assets";
import myPhoto from "../assets/myself/myself.png";
import { personJsonLd, site, websiteJsonLd } from "../lib/site";
---

<Base
    title={site.name}
    description={site.description}
    canonicalPath="/"
    jsonLd={[personJsonLd, websiteJsonLd]}
>
    <main
        id="main"
        class="relative mx-auto max-w-3xl px-6 py-24 md:py-40"
        data-hover-root
    >
        <HoverLens />

        <div class="space-y-20 md:space-y-[120px]">
            <div class="flex flex-col lg:flex-row align-top gap-4">
                <div class="space-y-4">
                    <h1 class="text-3xl font-bold text-mauve-800">
                        Gregor Tokarev
                    </h1>
                    <p class="text-mauve-700 text-base md:text-lg">
                        Software engineer. I started programming at 12. Landed
                        my first paid job at 15. Became team lead at the age of
                        20. Currently, I work at the biggest e-commerce platform
                        in Russia.
                    </p>
                    <p class="text-mauve-700 text-base md:text-lg">
                        I care about my craft more than anything else.
                    </p>
                    <Socials />
                </div>
                <Image
                    src={myPhoto}
                    alt="My photo"
                    class="md:w-[280px] md:h-[380px] h-[220px] shrink-0 object-cover object-[center_30%] md:object-center"
                />
            </div>

            <Projects />

            <Experience />

            <Posts limit={5} />
        </div>
    </main>

    <script>
        const KEY = "index-scroll-y";
        let currentPath = location.pathname;

        const saveIfOnIndex = () => {
            if (currentPath === "/") {
                sessionStorage.setItem(KEY, String(window.scrollY));
            }
        };

        document.addEventListener("astro:before-preparation", saveIfOnIndex);
        window.addEventListener("pagehide", saveIfOnIndex);

        document.addEventListener("astro:page-load", () => {
            currentPath = location.pathname;
            if (currentPath !== "/") return;
            const raw = sessionStorage.getItem(KEY);
            if (raw === null) return;
            const y = parseInt(raw, 10);
            if (Number.isFinite(y)) {
                window.scrollTo({ top: y, left: 0, behavior: "instant" });
            }
        });
    </script>
</Base>
