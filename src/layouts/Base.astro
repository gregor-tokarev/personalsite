---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import MusicPlayer from "../components/MusicPlayer.astro";
import { canonicalUrl, site } from "../lib/site";

interface Props {
    title: string;
    description?: string;
    canonicalPath?: string | false;
    image?: string;
    noindex?: boolean;
    type?: "website" | "article";
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
    title,
    description = site.description,
    canonicalPath = Astro.url.pathname,
    image,
    noindex = false,
    type = "website",
    jsonLd,
} = Astro.props;

const canonical = canonicalPath === false ? undefined : canonicalUrl(canonicalPath);
const imageUrl = image ? new URL(image, site.url).toString() : undefined;
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const serializeJsonLd = (item: Record<string, unknown>) =>
    JSON.stringify(item).replace(/</g, "\\u003c");
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon.png?v=20260505" />
        <link rel="icon" href="/favicon.ico?v=20260505" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content={site.themeColor} />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex, follow" />}
        {canonical && <link rel="canonical" href={canonical} />}
        <meta property="og:site_name" content={site.name} />
        <meta property="og:locale" content={site.locale} />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {canonical && <meta property="og:url" content={canonical} />}
        {imageUrl && <meta property="og:image" content={imageUrl} />}
        <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {imageUrl && <meta name="twitter:image" content={imageUrl} />}
        <link
            rel="preload"
            href="/fonts/cantarell-400-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>{title}</title>
        {jsonLdItems.map((item) => (
            <script type="application/ld+json" set:html={serializeJsonLd(item)} />
        ))}
        <script
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="a47028cb-12aa-460d-b901-a18ec76bc536"
        ></script>
        <ClientRouter />
    </head>
    <body class="min-h-screen bg-[#39414e]">
        <MusicPlayer />
        <slot />
    </body>
</html>
