---
import Base from "../layouts/Base.astro";
---

<Base
    title="Page not found — Gregor Tokarev"
    description="The requested page could not be found."
    canonicalPath={false}
    noindex
>
    <main
        id="main"
        class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-6 px-6 py-24"
    >
        <p class="text-sm font-semibold text-muted">404</p>
        <h1 class="text-3xl font-bold text-accent">Page not found</h1>
        <p class="text-fg">
            The page you are looking for is not available.
        </p>
        <a
            href="/"
            class="self-start text-fg underline decoration-accent/40 underline-offset-2 decoration-2 hover:decoration-accent/80"
        >
            Back home
        </a>
    </main>
</Base>
