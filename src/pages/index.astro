---
import "../styles/global.css";
import MusicPlayer from "../components/MusicPlayer.astro";
import Projects from "../components/Projects.astro";
import projectOne from "../assets/projects/voxfusion.png";
import projectTwo from "../assets/projects/profile-left.png";
import projectThree from "../assets/projects/profile-right.png";

const projects = [
    {
        title: "voxfusion",
        meta: "2026 · macos dictating app",
        image: projectOne,
    },
    {
        title: "Sit Amet Consectetur",
        meta: "2024 · Interaction design",
        image: projectTwo,
    },
    {
        title: "Adipiscing Elit",
        meta: "2023 · 3D rendering",
        image: projectThree,
    },
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link
            rel="preload"
            href="/fonts/cantarell-400-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>Gregor Tokarev</title>
    </head>
    <body class="min-h-screen bg-[#a8e0df]">
        <MusicPlayer />
        <main class="mx-auto max-w-3xl pt-40 pb-40">
            <div class="space-y-4 group">
                <h1 class="text-3xl font-bold text-mauve-800">Gregor Tokarev</h1>
                <p class="text-mauve-700 text-lg">
                    Software engineer, care about my craft more then anything else in life
                    <a href="#" class="underline">link</a>
                </p>
            </div>

            <div class="mt-20">
                <Projects projects={projects} />
            </div>
        </main>
    </body>
</html>
