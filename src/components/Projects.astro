---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import projectOne from "../assets/projects/voxfusion.png";

interface Project {
    title: string;
    meta: string;
    image: ImageMetadata;
    link: string;
}

const projects: Project[] = [
    {
        title: "voxfusion",
        meta: "2026 · macos dictating app",
        image: projectOne,
        link: "https://voxfusion.io",
    },
    {
        title: "example one",
        meta: "2025 · example project",
        image: projectOne,
        link: "https://example.com",
    },
    {
        title: "example two",
        meta: "2024 · example project",
        image: projectOne,
        link: "https://example.com",
    },
];

const PREVIEW_MAX = 400;

const fitWithin = (img: ImageMetadata, max: number) => {
    const ratio = img.width / img.height;
    return ratio >= 1
        ? { width: max, height: Math.round(max / ratio) }
        : { width: Math.round(max * ratio), height: max };
};

const displays = projects.map((p) => fitWithin(p.image, PREVIEW_MAX));

const previews = await Promise.all(
    projects.map((p, i) =>
        getImage({
            src: p.image,
            width: displays[i].width * 2,
            height: displays[i].height * 2,
            format: "webp",
        }),
    ),
);
---

{previews.map((img) => (
    <link rel="preload" as="image" href={img.src} />
))}

<section
    class="relative"
    data-projects
    aria-labelledby="projects-heading"
>
    <h2 id="projects-heading" class="sr-only">Projects</h2>
    <div class="relative flex flex-col gap-1 -mx-4 w-fit" data-projects-list>
        {projects.map((p, i) => (
            <a
                href={p.link}
                target="_blank"
                rel="noopener noreferrer"
                data-project-link
                data-hover-target
                data-index={i}
                class="project-link relative flex w-fit flex-col gap-1 px-4 py-2 no-underline text-mauve-800"
            >
                <span class="underline decoration-mauve-800/40 underline-offset-2 decoration-2">
                    {p.title}
                    <span class="sr-only"> (opens in a new tab)</span>
                </span>
                <span class="text-sm text-mauve-600">{p.meta}</span>
            </a>
        ))}
    </div>

    <div
        class="preview-anchor pointer-events-none absolute top-1/2 hidden md:block"
        data-preview-wrapper
        aria-hidden="true"
    >
        {projects.map((p, i) => (
            <Image
                src={p.image}
                alt=""
                width={displays[i].width * 2}
                height={displays[i].height * 2}
                format="webp"
                loading="eager"
                data-preview
                data-index={i}
                class="preview-img absolute top-0 left-0 max-w-none rounded-xl object-cover transition-[opacity,filter,transform] duration-300 ease-out"
                style={`width:${displays[i].width}px; height:${displays[i].height}px;`}
            />
        ))}
    </div>
</section>

<style>
    .preview-anchor {
        left: calc(50% + 220px);
    }
    @media (min-width: 1024px) {
        .preview-anchor {
            left: calc(50% + 260px);
        }
    }
    .preview-img {
        opacity: 0;
        filter: blur(6px);
        transform: translate(-50%, -50%) scale(0.96);
        transform-origin: center;
    }
    .preview-img[data-active] {
        opacity: 1;
        filter: blur(0);
        transform: translate(-50%, -50%) scale(1);
    }
    .project-link:focus-visible {
        outline: 2px solid var(--color-mauve-800);
        outline-offset: -2px;
        border-radius: 12px;
    }
    @media (prefers-reduced-motion: reduce) {
        .preview-img {
            transition-duration: 80ms !important;
            filter: none;
        }
    }
</style>

<script>
    function initProjects(root: HTMLElement) {
        if (root.dataset.projectsReady) return;
        root.dataset.projectsReady = "1";
        const list = root.querySelector<HTMLElement>("[data-projects-list]");
        const links = root.querySelectorAll<HTMLAnchorElement>("[data-project-link]");
        const previews = root.querySelectorAll<HTMLImageElement>("[data-preview]");
        if (!list || !links.length) return;

        const showPreview = (idx: string | undefined) => {
            previews.forEach((img) => {
                if (img.dataset.index === idx) img.setAttribute("data-active", "");
                else img.removeAttribute("data-active");
            });
        };

        const hideAll = () => {
            previews.forEach((img) => img.removeAttribute("data-active"));
        };

        links.forEach((link) => {
            link.addEventListener("pointerenter", (e) => {
                if (e.pointerType === "touch") return;
                showPreview(link.dataset.index);
            });
            link.addEventListener("focus", () => {
                if (!link.matches(":focus-visible")) return;
                showPreview(link.dataset.index);
            });
        });

        list.addEventListener("pointerleave", (e) => {
            if (e.pointerType === "touch") return;
            hideAll();
        });
        list.addEventListener("focusout", (e) => {
            if (!list.contains(e.relatedTarget as Node)) hideAll();
        });
    }

    const runProjects = () =>
        document.querySelectorAll<HTMLElement>("[data-projects]").forEach(initProjects);

    runProjects();
    document.addEventListener("astro:page-load", runProjects);
</script>
