---
interface Social {
    label: string;
    href: string;
}

const socials: Social[] = [
    {
        label: "twitter",
        href: "https://x.com/gregortokarev",
    },
    {
        label: "github",
        href: "https://github.com/gregor-tokarev",
    },
];
---

<nav
    class="relative"
    data-socials
    aria-label="Social links"
>
    <div class="relative flex flex-row flex-wrap items-center gap-1 -mx-3 w-fit" data-socials-list>
        <span
            aria-hidden="true"
            class="hover-lens pointer-events-none absolute left-0 top-0 rounded-xl opacity-0 transition-[transform,width,height,opacity] duration-300 ease-out"
            data-hover-bg
        ></span>

        {socials.map((s) => (
            <a
                href={s.href}
                target="_blank"
                rel="me noopener noreferrer"
                data-social-link
                class="social-link relative flex items-center gap-1.5 px-3 py-1.5 no-underline text-mauve-800"
            >
                <span class="underline decoration-mauve-800/40 underline-offset-2 decoration-2">
                    {s.label}
                    <span class="sr-only"> (opens in a new tab)</span>
                </span>
            </a>
        ))}
    </div>
</nav>

<style>
    .hover-lens {
        box-shadow:
            inset 0 1px 0 0 rgba(255, 255, 255, 0.55),
            inset 0 -1px 0 0 rgba(255, 255, 255, 0.18),
            0 0 0 1px rgba(255, 255, 255, 0.22),
            0 6px 18px -6px rgba(20, 16, 34, 0.18);
    }

    .social-link:focus-visible {
        outline: 2px solid var(--color-mauve-800);
        outline-offset: -2px;
        border-radius: 10px;
    }

    @media (prefers-reduced-motion: reduce) {
        .hover-lens {
            transition-duration: 80ms !important;
        }
    }
</style>

<script>
    function initSocials(root: HTMLElement) {
        if (root.dataset.socialsReady) return;
        root.dataset.socialsReady = "1";
        const list = root.querySelector<HTMLElement>("[data-socials-list]");
        const hoverBg = root.querySelector<HTMLElement>("[data-hover-bg]");
        const links = root.querySelectorAll<HTMLAnchorElement>("[data-social-link]");
        if (!list || !hoverBg || !links.length) return;

        const moveBgTo = (link: HTMLElement) => {
            const listRect = list.getBoundingClientRect();
            const r = link.getBoundingClientRect();
            hoverBg.style.transform = `translate(${r.left - listRect.left}px, ${r.top - listRect.top}px)`;
            hoverBg.style.width = `${r.width}px`;
            hoverBg.style.height = `${r.height}px`;
            hoverBg.style.opacity = "1";
        };

        const hideAll = () => {
            hoverBg.style.opacity = "0";
        };

        links.forEach((link) => {
            link.addEventListener("pointerenter", (e) => {
                if (e.pointerType === "touch") return;
                moveBgTo(link);
            });
            link.addEventListener("focus", () => {
                if (!link.matches(":focus-visible")) return;
                moveBgTo(link);
            });
        });

        list.addEventListener("pointerleave", (e) => {
            if (e.pointerType === "touch") return;
            hideAll();
        });
        list.addEventListener("focusout", (e) => {
            if (!list.contains(e.relatedTarget as Node)) hideAll();
        });
    }

    const runSocials = () =>
        document.querySelectorAll<HTMLElement>("[data-socials]").forEach(initSocials);

    runSocials();
    document.addEventListener("astro:page-load", runSocials);
</script>
