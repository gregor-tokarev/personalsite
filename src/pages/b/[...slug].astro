---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
});
---

<Base title={`${post.data.title} — Gregor Tokarev`} description={post.data.description}>
    <main id="main" class="mx-auto max-w-2xl px-6 py-24 md:py-40">
        <a
            href="/"
            class="inline-block text-sm text-mauve-600 hover:text-mauve-800 mb-12"
        >
            ←&nbsp;Back
        </a>

        <article class="space-y-10">
            <header class="space-y-3">
                <p class="text-sm tabular-nums text-mauve-600">
                    <time datetime={post.data.date.toISOString()}>
                        {fmt.format(post.data.date)}
                    </time>
                    {post.data.category && (
                        <span> · {post.data.category}</span>
                    )}
                </p>
                <h1
                    class="text-3xl md:text-4xl font-bold text-mauve-800 leading-tight"
                    transition:name={`post-title-${post.id}`}
                >
                    {post.data.title}
                </h1>
                <p class="text-lg text-mauve-700">
                    {post.data.description}
                </p>
            </header>

            <div class="post-body text-mauve-800">
                <Content />
            </div>
        </article>
    </main>

    <script>
        const COPY_SVG = `<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
        const CHECK_SVG = `<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

        function ensureLiveRegion(): HTMLElement {
            let live = document.getElementById("copy-live") as HTMLElement | null;
            if (!live) {
                live = document.createElement("div");
                live.id = "copy-live";
                live.setAttribute("aria-live", "polite");
                live.setAttribute("aria-atomic", "true");
                live.style.cssText =
                    "position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;";
                document.body.appendChild(live);
            }
            return live;
        }

        function addCopyButtons() {
            const pres = document.querySelectorAll<HTMLElement>(
                ".post-body pre",
            );
            pres.forEach((pre) => {
                if (pre.dataset.copyReady) return;
                pre.dataset.copyReady = "1";
                pre.style.position = "relative";
                pre.tabIndex = 0;

                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "code-copy-btn";
                btn.setAttribute("aria-label", "Copy code");
                btn.innerHTML = COPY_SVG;

                let resetTimer: number | undefined;
                btn.addEventListener("click", async () => {
                    const code = pre.querySelector("code");
                    const text = (code?.innerText ?? pre.innerText) || "";
                    const live = ensureLiveRegion();
                    try {
                        await navigator.clipboard.writeText(text);
                        btn.innerHTML = CHECK_SVG;
                        btn.dataset.copied = "1";
                        live.textContent = "Code copied to clipboard";
                        window.clearTimeout(resetTimer);
                        resetTimer = window.setTimeout(() => {
                            btn.innerHTML = COPY_SVG;
                            delete btn.dataset.copied;
                        }, 1600);
                    } catch {
                        live.textContent = "Copy failed. Press Cmd or Ctrl + C to copy.";
                    }
                });

                pre.appendChild(btn);
            });
        }

        addCopyButtons();
        document.addEventListener("astro:page-load", addCopyButtons);
    </script>

    <style is:global>
        .post-body {
            font-size: 1.0625rem;
            line-height: 1.7;
        }
        .post-body > * + * {
            margin-top: 1.25em;
        }
        .post-body h2,
        .post-body h3 {
            scroll-margin-top: 2rem;
            text-wrap: balance;
        }
        .post-body h2 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-top: 2em;
            color: var(--color-mauve-800);
        }
        .post-body h3 {
            font-size: 1.25rem;
            font-weight: 700;
            margin-top: 1.75em;
        }
        .post-body p {
            text-wrap: pretty;
        }
        .post-body a {
            text-decoration: underline;
            text-decoration-color: rgba(45, 36, 56, 0.55);
            text-underline-offset: 2px;
        }
        .post-body a:hover {
            text-decoration-color: rgba(45, 36, 56, 0.9);
        }
        .post-body blockquote {
            border-left: 2px solid rgba(45, 36, 56, 0.2);
            padding-left: 1rem;
            color: var(--color-mauve-700);
            font-style: italic;
        }
        .post-body ul,
        .post-body ol {
            padding-left: 1.5rem;
        }
        .post-body ul {
            list-style: disc;
        }
        .post-body ol {
            list-style: decimal;
        }
        .post-body li + li {
            margin-top: 0.4em;
        }
        .post-body code {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.92em;
            background: rgba(45, 36, 56, 0.08);
            padding: 0.1em 0.35em;
            border-radius: 4px;
        }
        .post-body pre {
            padding: 1rem 1.25rem;
            padding-right: 3rem;
            border-radius: 10px;
            overflow-x: auto;
            font-size: 0.9rem;
            line-height: 1.55;
        }
        .post-body pre code {
            background: transparent;
            padding: 0;
        }
        .code-copy-btn {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            color: rgba(255, 255, 255, 0.7);
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            opacity: 0;
            transition:
                opacity 150ms ease,
                color 150ms ease,
                transform 150ms ease;
        }
        .post-body pre:hover .code-copy-btn,
        .post-body pre:focus-within .code-copy-btn,
        .code-copy-btn:focus-visible {
            opacity: 1;
        }
        .code-copy-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.18);
        }
        .code-copy-btn:active {
            transform: scale(0.94);
        }
        .code-copy-btn[data-copied] {
            opacity: 1;
            color: #7ee2a8;
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(126, 226, 168, 0.35);
        }
        .code-copy-btn[data-copied] svg {
            animation: copy-check-bounce 320ms cubic-bezier(0.34, 1.4, 0.64, 1);
        }
        @keyframes copy-check-bounce {
            0% {
                transform: scale(1);
            }
            55% {
                transform: scale(1.08);
            }
            100% {
                transform: scale(1);
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .code-copy-btn {
                transition: opacity 80ms ease;
            }
            .code-copy-btn[data-copied] svg {
                animation: none;
            }
        }
    </style>
</Base>
