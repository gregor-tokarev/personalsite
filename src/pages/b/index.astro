---
import Base from "../../layouts/Base.astro";
import Masthead from "../../components/Masthead.astro";
import Posts from "../../components/Posts.astro";
import { getPublishedPosts } from "../../lib/posts";
import { main } from "../../lib/ui";

const posts = await getPublishedPosts();
const hasPosts = posts.length > 0;
---

<Base
    title="Thoughts — Gregor Tokarev"
    description="Notes and writing by Gregor Tokarev on software engineering and tools."
    canonicalPath="/b/"
    noindex={!hasPosts}
>
    <main id="main" class={main}>
        <Masthead />

        <header class="mt-11">
            <h1 class="text-[1.375rem] leading-[1.45] font-bold text-accent">Thoughts</h1>
            <p class="mt-1 text-muted">Notes on software engineering, tools, and product craft.</p>
        </header>

        <div class="mt-10">
            {hasPosts ? <Posts posts={posts} descriptions /> : <p class="text-muted">Nothing is published yet.</p>}
        </div>
    </main>
</Base>
