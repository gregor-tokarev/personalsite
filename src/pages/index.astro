---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import MusicPlayer from "../components/MusicPlayer.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Posts from "../components/Posts.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Gregor Tokarev — software engineer building thoughtful tools and writing about the craft."
        />
        <link
            rel="preload"
            href="/fonts/cantarell-400-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>Gregor Tokarev</title>
        <ClientRouter />
    </head>
    <body class="min-h-screen bg-[#a8e0df]">
        <MusicPlayer />
        <main class="mx-auto space-y-[120px]  max-w-3xl py-40">
            <div class="space-y-4 group">
                <h1 class="text-3xl font-bold text-mauve-800">
                    Gregor Tokarev
                </h1>
                <p class="text-mauve-700 text-lg">
                    Software engineer, care about my craft more then anything
                    else in life
                    <a href="https://example.com" class="underline">link</a>
                </p>
            </div>

            <Projects />

            <Experience />

            <Posts />
        </main>
    </body>
</html>
