---
import type { CollectionEntry } from "astro:content";
import { shortDate } from "../lib/posts";
import { link, row } from "../lib/ui";

interface Props {
    posts: CollectionEntry<"posts">[];
    descriptions?: boolean;
}

const { posts, descriptions = false } = Astro.props;
---

<ul class="group/list">
    {
        posts.map((p) => (
            <li>
                <a
                    href={`/b/${p.id}/`}
                    data-umami-event="post_click"
                    data-umami-event-post={p.id}
                    class:list={[
                        row,
                        "group transition-opacity duration-200 group-hover/list:not-hover:opacity-50",
                        descriptions && "sm:py-[0.55rem]",
                    ]}
                >
                    <span class="text-muted tabular-nums">
                        <time datetime={p.data.date.toISOString()}>{shortDate.format(p.data.date)}</time>
                    </span>
                    <span>
                        <span
                            class:list={[link, "group-hover:decoration-accent"]}
                            transition:name={`post-title-${p.id}`}
                        >
                            {p.data.title}
                        </span>
                        {descriptions && <span class="mt-1 block text-muted">{p.data.description}</span>}
                    </span>
                </a>
            </li>
        ))
    }
</ul>
