---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import projectOne from "../assets/projects/voxfusion.png";
import projectTwo from "../assets/projects/profile-left.png";
import projectThree from "../assets/projects/profile-right.png";

interface Project {
    title: string;
    meta: string;
    image: ImageMetadata;
    link: string;
}

const projects: Project[] = [
    {
        title: "voxfusion",
        meta: "2026 · macos dictating app",
        image: projectOne,
        link: "https://voxfusion.io",
    },
    {
        title: "Sit Amet Consectetur",
        meta: "2024 · Interaction design",
        image: projectTwo,
        link: "https://example.com",
    },
    {
        title: "Adipiscing Elit",
        meta: "2023 · 3D rendering",
        image: projectThree,
        link: "https://example.com",
    },
];

const PREVIEW_MAX = 400;

const fitWithin = (img: ImageMetadata, max: number) => {
    const ratio = img.width / img.height;
    return ratio >= 1
        ? { width: max, height: Math.round(max / ratio) }
        : { width: Math.round(max * ratio), height: max };
};

const displays = projects.map((p) => fitWithin(p.image, PREVIEW_MAX));

const previews = await Promise.all(
    projects.map((p, i) =>
        getImage({
            src: p.image,
            width: displays[i].width * 2,
            height: displays[i].height * 2,
            format: "webp",
        }),
    ),
);
---

{previews.map((img) => (
    <link rel="preload" as="image" href={img.src} />
))}

<section data-projects>
    <div class="relative flex flex-col gap-1 -mx-4 w-fit" data-projects-list>
        <span
            aria-hidden="true"
            class="hover-lens pointer-events-none absolute left-0 top-0 rounded-2xl opacity-0 transition-[transform,width,height,opacity] duration-300 ease-out"
            data-hover-bg
        ></span>

        {projects.map((p, i) => (
            <a
                href={p.link}
                target="_blank"
                rel="noopener noreferrer"
                data-project-link
                data-index={i}
                class="relative flex w-fit flex-col gap-1 px-4 py-2 no-underline text-mauve-800"
            >
                <span class="underline decoration-mauve-800/15 underline-offset-2 decoration-2">
                    {p.title}
                </span>
                <span class="text-sm text-mauve-700/70">{p.meta}</span>
            </a>
        ))}
    </div>

    <div
        class="preview-anchor pointer-events-none fixed top-1/2 hidden md:block"
        data-preview-wrapper
        aria-hidden="true"
    >
        {projects.map((p, i) => (
            <Image
                src={p.image}
                alt=""
                width={displays[i].width * 2}
                height={displays[i].height * 2}
                format="webp"
                loading="eager"
                data-preview
                data-index={i}
                class="preview-img absolute top-0 left-0 max-w-none rounded-xl object-cover transition-[opacity,filter,transform] duration-300 ease-out"
                style={`width:${displays[i].width}px; height:${displays[i].height}px;`}
            />
        ))}
    </div>
</section>

<style>
    .hover-lens {
        box-shadow:
            inset 0 1px 0 0 rgba(255, 255, 255, 0.55),
            inset 0 -1px 0 0 rgba(255, 255, 255, 0.18),
            0 0 0 1px rgba(255, 255, 255, 0.22),
            0 6px 18px -6px rgba(20, 16, 34, 0.18);
    }

    .preview-anchor {
        left: calc(50% + 220px);
    }
    @media (min-width: 1024px) {
        .preview-anchor {
            left: calc(50% + 260px);
        }
    }
    .preview-img {
        opacity: 0;
        filter: blur(6px);
        transform: translate(-50%, -50%) scale(0.96);
        transform-origin: center;
    }
    .preview-img[data-active] {
        opacity: 1;
        filter: blur(0);
        transform: translate(-50%, -50%) scale(1);
    }
</style>

<script>
    function initProjects(root: HTMLElement) {
        if (root.dataset.projectsReady) return;
        root.dataset.projectsReady = "1";
        const list = root.querySelector<HTMLElement>("[data-projects-list]");
        const hoverBg = root.querySelector<HTMLElement>("[data-hover-bg]");
        const links = root.querySelectorAll<HTMLAnchorElement>("[data-project-link]");
        const previews = root.querySelectorAll<HTMLImageElement>("[data-preview]");
        if (!list || !hoverBg || !links.length) return;

        const moveBgTo = (link: HTMLElement) => {
            const listRect = list.getBoundingClientRect();
            const r = link.getBoundingClientRect();
            hoverBg.style.transform = `translate(${r.left - listRect.left}px, ${r.top - listRect.top}px)`;
            hoverBg.style.width = `${r.width}px`;
            hoverBg.style.height = `${r.height}px`;
            hoverBg.style.opacity = "1";
        };

        const showPreview = (idx: string | undefined) => {
            previews.forEach((img) => {
                if (img.dataset.index === idx) img.setAttribute("data-active", "");
                else img.removeAttribute("data-active");
            });
        };

        const hideAll = () => {
            hoverBg.style.opacity = "0";
            previews.forEach((img) => img.removeAttribute("data-active"));
        };

        links.forEach((link) => {
            const activate = () => {
                moveBgTo(link);
                showPreview(link.dataset.index);
            };
            link.addEventListener("mouseenter", activate);
            link.addEventListener("focus", activate);
        });

        list.addEventListener("mouseleave", hideAll);
        list.addEventListener("focusout", (e) => {
            if (!list.contains(e.relatedTarget as Node)) hideAll();
        });
    }

    const runProjects = () =>
        document.querySelectorAll<HTMLElement>("[data-projects]").forEach(initProjects);

    runProjects();
    document.addEventListener("astro:page-load", runProjects);
</script>
