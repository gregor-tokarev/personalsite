---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Masthead from "../../components/Masthead.astro";
import { getPublishedPosts, longDate } from "../../lib/posts";
import { canonicalUrl } from "../../lib/site";
import { link, main } from "../../lib/ui";

export async function getStaticPaths() {
    const posts = await getPublishedPosts();
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonicalPath = `/b/${post.id}/`;
const url = canonicalUrl(canonicalPath);
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    mainEntityOfPage: url,
    author: {
        "@type": "Person",
        name: "Gregor Tokarev",
        url: "https://tokarev.work/",
    },
    publisher: {
        "@type": "Person",
        name: "Gregor Tokarev",
        url: "https://tokarev.work/",
    },
};
---

<Base
    title={`${post.data.title} — Gregor Tokarev`}
    description={post.data.description}
    canonicalPath={canonicalPath}
    type="article"
    jsonLd={articleJsonLd}
>
    <main id="main" class={main}>
        <Masthead />

        <article>
            <header class="mt-11">
                <p class="text-muted tabular-nums">
                    <time datetime={post.data.date.toISOString()}>
                        {longDate.format(post.data.date)}
                    </time>
                    {post.data.category && <span> · {post.data.category}</span>}
                </p>
                <h1
                    class="mt-1 text-[1.375rem] leading-[1.45] font-bold text-accent"
                    transition:name={`post-title-${post.id}`}
                >
                    {post.data.title}
                </h1>
                <p class="mt-3 text-muted">{post.data.description}</p>
            </header>

            <div class="post-body mt-10">
                <Content />
            </div>
        </article>

        <footer class="mt-17">
            <a
                href="/b/"
                data-umami-event="more_posts_click"
                class:list={[link, "hover:decoration-accent"]}
            >
                ←&nbsp;All thoughts
            </a>
        </footer>
    </main>

    <script>
        const COPY_SVG = `<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
        const CHECK_SVG = `<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

        function ensureLiveRegion(): HTMLElement {
            let live = document.getElementById("copy-live") as HTMLElement | null;
            if (!live) {
                live = document.createElement("div");
                live.id = "copy-live";
                live.setAttribute("aria-live", "polite");
                live.setAttribute("aria-atomic", "true");
                live.style.cssText =
                    "position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;";
                document.body.appendChild(live);
            }
            return live;
        }

        function addCopyButtons() {
            const pres = document.querySelectorAll<HTMLElement>(".post-body pre");
            pres.forEach((pre) => {
                if (pre.dataset.copyReady) return;
                pre.dataset.copyReady = "1";
                pre.style.position = "relative";

                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "code-copy-btn";
                btn.setAttribute("aria-label", "Copy code");
                btn.innerHTML = COPY_SVG;

                let resetTimer: number | undefined;
                btn.addEventListener("click", async () => {
                    const code = pre.querySelector("code");
                    const text = (code?.innerText ?? pre.innerText) || "";
                    const live = ensureLiveRegion();
                    try {
                        await navigator.clipboard.writeText(text);
                        btn.innerHTML = CHECK_SVG;
                        btn.dataset.copied = "1";
                        live.textContent = "Code copied to clipboard";
                        window.clearTimeout(resetTimer);
                        resetTimer = window.setTimeout(() => {
                            btn.innerHTML = COPY_SVG;
                            delete btn.dataset.copied;
                        }, 1600);
                    } catch {
                        live.textContent = "Copy failed. Press Cmd or Ctrl + C to copy.";
                    }
                });

                pre.appendChild(btn);
            });
        }

        addCopyButtons();
        document.addEventListener("astro:page-load", addCopyButtons);
    </script>

    <style is:global>
        .post-body > * + * {
            margin-top: 1.25em;
        }
        .post-body h2,
        .post-body h3 {
            font-weight: 700;
            color: var(--color-fg);
            scroll-margin-top: 2rem;
        }
        .post-body h2 {
            font-size: 1.25rem;
            line-height: 1.45;
            margin-top: 3rem;
        }
        .post-body h3 {
            font-size: 1.0625rem;
            margin-top: 2.25rem;
        }
        .post-body a {
            text-decoration: underline;
            text-decoration-color: color-mix(in oklab, var(--color-accent) 50%, transparent);
            text-decoration-thickness: 1.5px;
            text-underline-offset: 3px;
            transition: text-decoration-color 200ms;
        }
        .post-body a:hover {
            text-decoration-color: var(--color-accent);
        }
        .post-body blockquote {
            border-left: 2px solid color-mix(in oklab, var(--color-accent) 45%, transparent);
            padding-left: 1.25rem;
        }
        .post-body ul,
        .post-body ol {
            padding-left: 1.5rem;
        }
        .post-body ul {
            list-style: disc;
        }
        .post-body ol {
            list-style: decimal;
        }
        .post-body li + li {
            margin-top: 0.4em;
        }
        .post-body li::marker {
            color: var(--color-muted);
        }
        .post-body code {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.92em;
            background: color-mix(in oklab, var(--color-fg) 8%, transparent);
            padding: 0.1em 0.35em;
            border-radius: 4px;
        }
        .post-body pre {
            padding: 1rem 1.25rem;
            padding-right: 3rem;
            border-radius: 8px;
            overflow-x: auto;
            font-size: 0.9rem;
            line-height: 1.55;
            background: color-mix(in oklab, var(--color-bg) 70%, black) !important;
        }
        .post-body pre code {
            background: transparent;
            padding: 0;
            font-size: 1em;
        }
        .post-body .table-scroll {
            overflow-x: auto;
        }
        .post-body table {
            width: 100%;
            border-collapse: collapse;
            font-variant-numeric: tabular-nums;
        }
        .post-body th,
        .post-body td {
            padding: 0.45rem 1.5rem 0.45rem 0;
            vertical-align: top;
        }
        .post-body th:last-child,
        .post-body td:last-child {
            padding-right: 0;
        }
        .post-body th {
            font-weight: 400;
            text-align: start;
            color: var(--color-muted);
            border-bottom: 1px solid color-mix(in oklab, var(--color-fg) 20%, transparent);
        }
        .post-body td {
            border-bottom: 1px solid color-mix(in oklab, var(--color-fg) 8%, transparent);
        }
        .post-body tr:last-child td {
            border-bottom: 0;
        }
        .post-body hr {
            border: 0;
            border-top: 1px solid color-mix(in oklab, var(--color-fg) 15%, transparent);
            margin-block: 2.5rem;
        }
        .post-body img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }
        .code-copy-btn {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            color: var(--color-muted);
            background: color-mix(in oklab, var(--color-fg) 8%, transparent);
            border: 1px solid color-mix(in oklab, var(--color-fg) 12%, transparent);
            cursor: pointer;
            opacity: 0;
            transition:
                opacity 150ms ease,
                color 150ms ease,
                transform 150ms ease;
        }
        .post-body pre:hover .code-copy-btn,
        .post-body pre:focus-within .code-copy-btn,
        .code-copy-btn:focus-visible {
            opacity: 1;
        }
        .code-copy-btn:hover {
            color: var(--color-fg);
            background: color-mix(in oklab, var(--color-fg) 14%, transparent);
        }
        .code-copy-btn:active {
            transform: scale(0.94);
        }
        .code-copy-btn[data-copied] {
            opacity: 1;
            color: var(--color-accent);
            border-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
        }
        .code-copy-btn[data-copied] svg {
            animation: copy-check-bounce 320ms cubic-bezier(0.34, 1.4, 0.64, 1);
        }
        @keyframes copy-check-bounce {
            0% {
                transform: scale(1);
            }
            55% {
                transform: scale(1.08);
            }
            100% {
                transform: scale(1);
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .code-copy-btn {
                transition: opacity 80ms ease;
            }
            .code-copy-btn[data-copied] svg {
                animation: none;
            }
        }
    </style>
</Base>
